# DevSpace AI — copy to .env and fill. Never commit .env.
# App
APP_ENV=development
DEBUG=false

# Database — PostgreSQL is the source of truth.
# Local Docker: postgresql+psycopg://devspace:devspace@postgres:5432/devspace
# Local host-run API: postgresql+psycopg://devspace:devspace@localhost:5432/devspace
# Neon: use the pooled URL (-pooler) for the app, and the direct (non-pooled)
# DATABASE_URL_UNPOOLED for Alembic migrations / pg_dump / replication.
DATABASE_URL=postgresql+psycopg://devspace:devspace@localhost:5432/devspace
DATABASE_URL_UNPOOLED=

# Redis (worker queue)
REDIS_URL=redis://localhost:6379/0

# Auth / JWT — generate a long random value in production
JWT_SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440
COOKIE_SECURE=false
COOKIE_NAME=devspace_session

# CORS (comma-separated). List both localhost and 127.0.0.1 forms so the
# browser origin matches whichever address the app is opened at.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Seed demo user (Phase 01)
SEED_DEMO_EMAIL=demo@devspace.ai
SEED_DEMO_PASSWORD=DemoPass123!
SEED_DEMO_NAME=Demo Student

# External integrations — leave empty until API preflight verifies them.
# Do NOT put keys in web/ or NEXT_PUBLIC_* variables.
META_API_KEY=
META_BASE_URL=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
STT_PROVIDER=
TTS_PROVIDER=

# LLM provider — "mock" (default, labeled dev replies) or "meta" (live Meta
# Model API; requires MODEL_API_KEY + MODEL_ID, never commit real values).
LLM_PROVIDER=mock
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_API_KEY=
MODEL_ID=
